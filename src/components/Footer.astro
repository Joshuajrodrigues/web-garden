---
const today = new Date();
---

<footer>
    <h4 class="fancy-font">
        &copy; {today.getFullYear()} Joshua Rodrigues. All rights reserved.
    </h4>
    <div class="title-font">
        <small>
            Contact : <a href="mailto:hello@joshuarodrigues.dev"
                >hello@joshuarodrigues.dev</a
            >
        </small>
        <div class="made-with runny-font">
            <small>Made with love</small>
            <small>Made without ai</small>
        </div>
    </div>
</footer>
<style>
    footer {
        padding: 2em 1em 6em 1em;
        color: #fff;
        height: 24vh;
        text-align: left;
        background-image: url("/src/images/footer.avif");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    a {
        color: var(--text);
        background-color: var(--accent-link);
        display: inline-block;
        text-decoration: none;
        padding: 2px 8px;
    }
    .made-with {
        display: flex;
        flex-direction: column;
    }
</style>
