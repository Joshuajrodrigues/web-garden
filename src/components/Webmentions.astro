---
const { url = Astro.url } = Astro.props;

const token = "6JWJVyMOTQqNBdpAxtKjMg";
const api = `https://webmention.io/api/mentions.jf2?target=${url}&token=${token}`;

const response = await fetch(api);
const data = await response.json();
const mentions = data.children || [];

const likes = mentions.filter((m) => m["wm-property"] === "like-of");
const replies = mentions.filter((m) =>
    ["in-reply-to", "mention-of"].includes(m["wm-property"]),
);
---

<div class="webmention-container">
    <hr />

    {
        likes.length > 0 && (
            <div class="likes">
                <h3>Likes</h3>
                <div class="facepile">
                    {likes.map((like) => (
                        <a href={like.author.url} title={like.author.name}>
                            <img
                                src={like.author.photo}
                                alt={like.author.name}
                                class="avatar"
                            />
                        </a>
                    ))}
                </div>
            </div>
        )
    }

    {/* Display Replies as Comments */}
    <div class="replies">
        <h3>Responses</h3>
        {
            replies.length > 0 ? (
                replies.map((reply) => (
                    <div class="reply">
                        <div class="author-meta">
                            <img
                                src={reply.author.photo}
                                alt=""
                                class="avatar"
                            />
                            <a href={reply.author.url}>
                                <strong>{reply.author.name}</strong>
                            </a>
                            <time>
                                {new Date(
                                    reply.published || reply["wm-received"],
                                ).toLocaleDateString()}
                            </time>
                        </div>
                        <div
                            class="content"
                            set:html={
                                reply.content?.html || reply.content?.text
                            }
                        />
                    </div>
                ))
            ) : (
                <p>
                    No responses yet. Link to this post or reply on social
                    media!
                </p>
            )
        }
    </div>
</div>

<style>
    .webmention-container {
        margin-top: 3rem;
        font-family: sans-serif;
    }
    .facepile {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }
    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #eee;
    }
    .reply {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border-left: 3px solid #ccc;
        background: #f9f9f9;
    }
    .author-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0.5rem;
    }
    .content {
        font-size: 0.95rem;
    }
    time {
        font-size: 0.8rem;
        color: #666;
    }
</style>
