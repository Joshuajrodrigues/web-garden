---
import HeaderLink from "./HeaderLink.astro";
---

<nav aria-label="Main Navigation">
    <div class="internal-links">
        <HeaderLink href="/">Garden</HeaderLink>
        <HeaderLink href="/work">Work</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
    </div>
    <div class="contact-link">
        <a class="mailto" href="mailto:hello@joshuarodrigues.dev">
            hello@joshuarodrigues.dev
        </a>
    </div>
</nav>

<style>
    nav {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        margin-top: 1em;
        gap: 1rem; /* Prevents items from touching when wrapping */
    }

    .internal-links {
        display: flex;
        align-items: center;
        /* Responsive gap using clamp */
        gap: clamp(1rem, 4vw, 2.5rem);
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 500;
    }

    a.mailto {
        color: var(--text);
        background-color: var(--accent-link);
        display: inline-block;
        text-decoration: underline;
        padding: 4px 12px;

        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        transition: opacity 0.2s ease-in-out;

        &:hover,
        &:focus {
            opacity: 0.8;
            outline: 2px solid var(--accent-link); /* Better focus visibility */
            outline-offset: 4px;
        }
    }

    /* Stack on mobile if the screen is very small */
    @media (max-width: 480px) {
        nav {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
