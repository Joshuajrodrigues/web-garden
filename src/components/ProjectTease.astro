---
import { getCollection } from "astro:content";
// Filter for posts that have "work-project" in their tags
const projects = await getCollection("garden", ({ data }) => {
    return data.tags && data.tags.includes("work-project");
});
---

<div class="work-grid">
    {
        projects.map((project) => (
            <a href={`/garden/${project.id}`} class="work-card">
                <div class="image-container">
                    {project.data.hero ? (
                        <img
                            src={project.data.hero}
                            alt={project.data.title}
                            class="project-image"
                        />
                    ) : (
                        <div class="placeholder-bg" />
                    )}

                </div>

                <div class="content">

                    <h3 class="title-font project-title">
                        {project.data.title}
                    </h3>
                    <p class="description">
                        {project.data.description ||
                            "Building robust frontend architectures for complex enterprise data."}
                    </p>
                    <div class="footer-link">
                        <span>Read more</span>
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </div>
                </div>
            </a>
        ))
    }
</div>

<style>
    .work-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        gap: 4rem 2rem;
        margin: 4rem 0;
    }

    .work-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        group;
    }

    /* Large Image Presentation */
    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--color-bg-secondary, #1a1a1a);
        margin-bottom: 1.5rem;
    }

    .project-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.19, 1, 0.22, 1);
        filter: grayscale(10%) contrast(1.1);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .view-tag {
        color: white;
        border: 1px solid white;
        padding: 0.5rem 1.5rem;
        font-size: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* Hover States */
    .work-card:hover .project-image {
        transform: scale(1.05);
    }

    .work-card:hover .image-overlay {
        opacity: 1;
    }

    /* Content Styling */
    .meta {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .tag {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent);
        font-weight: 700;
    }

    .project-title {
        font-size: 2.2rem;
        margin: 0 0 0.5rem 0;
        line-height: 1.1;
    }

    .description {
        font-size: 1rem;
        opacity: 0.8;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        max-width: 50ch;
    }

    .footer-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        transition: gap 0.3s ease;
    }

    .work-card:hover .footer-link {
        gap: 1rem;
        color: var(--accent);
    }

    @media (max-width: 768px) {
        .work-grid {
            grid-template-columns: 1fr;
        }
        .project-title {
            font-size: 1.8rem;
        }
    }
</style>
