---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<h2 class="title-font">Selected Works</h2>

<div class="blog-tease">
    {
        posts.map((post) => (
            <div class="blog-post">
                <a href={post.url}>
                    <h3 class=" title-font">{post.data.title}</h3>
                    <p>{post.data.description}</p>
                </a>
            </div>
        ))
    }
</div>

<style>
    .blog-tease {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin: 4rem 0;
    }

    .blog-post {
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    }

    .blog-post h3 {
        font-size: 1.4rem;
        margin-bottom: 0.25rem;
    }

    .blog-post p {
        font-size: 0.95rem;
        opacity: 0.8;
    }

    .blog-post a {
        text-decoration: none;
        color: inherit;
    }

    .blog-post a:hover {
        opacity: 0.75;
    }

    @media (min-width: 768px) {
        .blog-tease {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
