---
import { getCollection } from "astro:content";
import tolstoy from "../images/logo2.jpg";
import { Image } from "astro:assets";
const posts = await getCollection("garden");
const randomPosts = posts.sort(() => Math.random() - 0.5);
---

<h2 class="section-title runny-font">Notes and musings</h2>

<section class="blog-tease">
    <ol class="post-list">
        {
            randomPosts.map((post) => (
                <li class="blog-post ">
                    <a href={"/garden/" + post.id}>{post.data.title}</a>
                    <div>
                        {post.data.tags?.map((tag) => (
                            <span class="tag">#{tag} </span>
                        ))}
                    </div>
                </li>
            ))
        }
    </ol>

    <div class="aside-image">
        <Image src={tolstoy} alt="Portrait of Leo Tolstoy" />
    </div>
</section>

<style>
    section-title {
        margin: 4rem 0 2rem;
        font-size: clamp(2rem, 4vw, 3rem);
    }

    .blog-tease {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: start;
    }

    .blog-post {
        margin-bottom: 1.25rem;
        list-style-type: upper-roman;
        cursor: pointer;
    }

    .blog-post h3 {
        font-size: clamp(1.2rem, 2.5vw, 1.6rem);
        font-weight: 400;
        line-height: 1.3;
    }

    /* Links */
    .blog-post a {
        text-decoration: none;
        color: var(--color-text);
        border-bottom: 1px solid currentColor;
        padding-bottom: 0.1em;
    }

    .blog-post a:hover {
        opacity: 0.75;
    }

    /* Image */
    .aside-image {
        display: none;
    }

    .aside-image img {
        width: 100%;
        height: auto;
        opacity: 0.9;
    }
    .tag {
        font-size: 13px;
        margin-right: 8px;
    }
    /* Desktop enhancement */
    @media (min-width: 768px) {
        .blog-tease {
            grid-template-columns: 3fr 2fr;
        }

        .aside-image {
            display: block;
            align-self: center;
        }
    }
</style>
