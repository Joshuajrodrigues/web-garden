---
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import handOfGod from "../images/righthandofgod.png";
---

<header>
    <h1 class="fancy-font xl"><a href="/">Joshua</a></h1>
    <Image class="hand-of-god" src={handOfGod} alt="right hand of god" />
</header>

<style>
    header {
        max-width: 1200px;
        margin: 0 auto;
    }
    a {
        text-decoration: none;
    }
    a:visited {
        color: unset;
    }
    img.hand-of-god {
        position: absolute;
        top: -90px;
        right: 0;
        z-index: -11;
    }
</style>
