---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Banner from "../components/Banner.astro";
import Webmentions from "../components/Webmentions.astro";

type Props = CollectionEntry<"garden">["data"];

const { title, description, tags, hero, attrib } = Astro.props;
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body>
        <main>
            <Banner />
            <Nav />
            <article>
                <header class="hero-container">
                    <button
                        onclick="history.back()"
                        class="back-button"
                        aria-label="Go back"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="m15 18-6-6 6-6"></path></svg
                        >
                        <span>Go back</span>
                    </button>

                    <div class="hero-image">
                        {
                            hero && (
                                <Image
                                    width={1200}
                                    height={600}
                                    src={hero}
                                    alt=""
                                    loading="eager"
                                />
                            )
                        }
                        <div class="hero-overlay"></div>
                        {
                            attrib && (
                                <span class="hero-attribution">{attrib}</span>
                            )
                        }
                    </div>

                    <div class="hero-content">
                        <h1 class="title-font">{title}</h1>
                        {
                            tags && (
                                <div class="tags-row">
                                    {tags.map((tag) => (
                                        <span class="tag">#{tag}</span>
                                    ))}
                                </div>
                            )
                        }
                    </div>
                </header>

                <div class="prose">
                    <slot />
                </div>
            </article>
            <Webmentions />
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .hero-container {
        position: relative;
        width: 100%;
        margin-top: 2rem;
        border-radius: 20px;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        min-height: 400px;
    }

    .hero-image {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.2) 0%,
            rgba(0, 0, 0, 0.7) 100%
        );
        z-index: 2;
    }

    /* Floating Back Button */
    .back-button {
        all: unset;
        cursor: pointer;
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        color: var(--bg);
        text-decoration: none;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: bold;
    }
    .back-button > svg {
        transition: transform 0.2s ease;
    }

    .back-button:hover {
        svg {
            transform: translateX(-4px);
        }
    }

    /* Content Overlaying Image */
    .hero-content {
        position: absolute;
        bottom: 0;
        left: 0;
        padding: 3rem 2rem;
        z-index: 3;
        color: white;
    }

    .hero-content h1 {
        margin: 0;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        line-height: 1.1;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .tags-row {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
        animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .tag {
        font-size: 0.9rem;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        padding: 0.2rem 0.8rem;
        border-radius: 4px;
        text-transform: lowercase;
    }

    /* Prose / Body Content */
    .prose {
        margin: 3rem auto;
        padding: 0 1rem;
        p {
            text-align: justify;
        }
    }

    /* Responsiveness */
    @media (max-width: 768px) {
        .hero-container {
            aspect-ratio: 4 / 5; /* Taller on mobile */
        }
        .hero-content {
            padding: 1.5rem;
        }
        .back-button span {
            display: none; /* Icon only on small mobile */
        }
    }
    @keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* 1. Animation for the Title */
    @keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-content h1 {
        animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* 2. The "Breakout" CSS for images inside Markdown <p> tags */
    .prose :global(p:has(img[title="section-image"])) {
        /* Force the parent <p> to be full width */
        width: 100%;

        margin-top: 4rem;
        margin-bottom: 4rem;
        padding: 0;
        line-height: 0; /* Removes weird gaps at the bottom of images */
    }

    .prose :global(img[title="section-image"]) {
        width: 100%;
        max-height: 700px; /* Or whatever height you prefer */
        border-radius: 20px;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
    }
    .hero-attribution {
        position: absolute;
        bottom: 10px;
        right: 8px;
        z-index: 4;
        font-size: clamp(0.4rem, 1vw, 1rem);
        color: rgba(255, 255, 255, 0.6);
        font-family: var(--font-mono, monospace);
        pointer-events: none;
    }
</style>
