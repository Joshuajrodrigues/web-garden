---
import BaseHead from "../components/BaseHead.astro";
import BlogTease from "../components/BlogTease.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import ProjectTease from "../components/ProjectTease.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <main>
            <Header />
            <Nav />
            <article>
                <h2 class="runny-font">
                    For some a prologue, for some an epilogue
                </h2>
                <p>
                    This space serves as a quiet record of my work, experiments,
                    passing interests and unsolicitated thoughts.
                </p>
                <p>
                    Much of my personal and professional life unfolds behind
                    closed doors, what is shared here remains necessarily
                    selective, shaped as much by restraint as by intention.
                </p>
                <a href="/garden/now">Here's what I'm doing now</a>
            </article>
            <BlogTease />

            <Footer />
        </main>
    </body>
</html>
<style>
    main {
        max-width: 1200px;
        margin: 0 auto;

        background-color: var(--bg);
    }
    h2 {
        font-size: 3rem;
    }
</style>
