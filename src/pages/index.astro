---
import Banner from "../components/Banner.astro";
import BaseHead from "../components/BaseHead.astro";
import BlogTease from "../components/BlogTease.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import ProjectTease from "../components/ProjectTease.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <main>
            <Banner />
            <Header />
            <Nav />
            <article>
                <h2 class="runny-font">
                    For some a prologue, for some an epilogue
                </h2>
                <p>
                    This space serves as a quiet record of my work, experiments,
                    passing interests and unsolicitated thoughts.
                </p>
                <p>
                    Much of my personal and professional life unfolds behind
                    closed doors, what is shared here remains necessarily
                    selective, shaped as much by restraint as by intention.
                </p>
                <a href="/garden/now">Here's what I'm doing now</a>
            </article>
            <section class="sudden-update">
                <p>
                    I'm in the process of self hosting a bunch of my sites and
                    projects.
                </p>
                <p>Hence this site is messier than usual</p>
                <p>
                    <b>but i love it</b>
                </p>
                <p>
                    check out{" "}
                    <a href="https://notes.joshuarodrigues.dev/explore?filter=tagSearch%3Aselfhostingseries">
                        my musings and experience while I learn self hosting
                    </a>
                </p>
                <p>
                    and for my more up todate notes{" "}
                    <a href="https://notes.joshuarodrigues.dev">
                        you can check out my entire self hosted memos instance.
                    </a>
                </p>
            </section>

            <BlogTease />

            <Footer />
        </main>
    </body>
</html>
<style>
    main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px 24px;
        background-color: var(--bg);
    }
    h2 {
        font-size: clamp(2.5rem, 8vw, 3.4rem);
    }
    .sudden-update {
        margin-top: 12px;
        border: 4px dashed black;
        width: fit-content;
        padding: 12px;
        background-color: #ff4500;
        color: white;
        font-weight: bolder;
        a {
            color: #f6aee1;
            display: inline-block;
            animation: slowHueShift 2s linear infinite;
        }
    }
    @keyframes slowHueShift {
        0% {
            filter: hue-rotate(0deg);
        }
        100% {
            filter: hue-rotate(360deg);
        }
    }
</style>
