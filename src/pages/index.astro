---
import BaseHead from "../components/BaseHead.astro";
import BlogTease from "../components/BlogTease.astro";
import ProjectTease from "../components/ProjectTease.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "@fontsource/unifrakturcook";
import "@fontsource/jacquard-24-charted";
import "@fontsource/pirata-one";
import "@fontsource/ibm-plex-serif";
// Supports weights 300-700
import "@fontsource-variable/cormorant-garamond";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <main>
            <Header />
            <Nav />
            <article>
                <h2 class="runny-font">
                    For some a prologue, for some an epilogue
                </h2>
                <p>
                    I’m a senior frontend engineer. This site is both a
                    portfolio and a digital garden: a place where finished work
                    and unfinished thoughts coexist.
                </p>
                <p>
                    I am in Goa, with over five years of experience working with
                    the web. Much of my time is spent tinkering with computers,
                    reading books, and following curiosities wherever they lead.
                </p>
                <p>
                    I build thoughtful, responsive web applications intended to
                    solve practical problems with care and precision.
                </p>
                <p>
                    This space serves as a quiet record of my work, experiments,
                    and passing interests. As much of my professional life
                    unfolds behind closed doors, what is shared here remains
                    necessarily selective, shaped as much by restraint as by
                    intention.
                </p>
            </article>
            <BlogTease />
            <ProjectTease />
            <Footer />
        </main>
    </body>
</html>
<style>
    main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px 24px;
        background-color: var(--bg);
    }
</style>
