---
import Layout from "../../layouts/GardenPost.astro";

import ProjectTease from "../../components/ProjectTease.astro";

const startDate = new Date(2021, 7); // August 2021 (0-indexed)
const now = new Date();

let years =
    now.getFullYear() -
    startDate.getFullYear() -
    (now.getMonth() < startDate.getMonth() ? 1 : 0);
---

<Layout
    title="My work and experience over the years"
    description="Work experience summary for hiring managers (hr's) and recuirmtment agents"
    attrib="The Great Day of His Wrath Painting (1853) John Martin"
    hero="https://en.wikipedia.org/wiki/The_Great_Day_of_His_Wrath#/media/File:John_Martin_-_The_Great_Day_of_His_Wrath_-_Google_Art_Project.jpg"
>
    <main>
        <article class="work-intro">
            <header class="work-header">
                <div class="heading-row">
                    <div class="actions">
                        <a
                            class="button primary"
                            href="/resume/Joshua-Rodrigues-Resume-2026.pdf"
                            target="_blank"
                        >
                            Résumé
                        </a>
                        <a
                            class="github-button"
                            href="https://github.com/joshuajrodrigues"
                            target="_blank"
                            aria-label="GitHub Profile"
                        >
                            <svg
                                height="32"
                                aria-hidden="true"
                                viewBox="0 0 16 16"
                                version="1.1"
                                width="32"
                                fill="currentColor"
                            >
                                <path
                                    d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <p class="big-intro">
                    I’m a <strong>Senior Frontend Engineer</strong> based in Goa,
                    with {years}+ years of experience building specialized
                    systems for scientists, researchers, and government
                    officials.
                </p>

                <div class="experience-cta">
                    <p>
                        For a detailed breakdown of my career path and work
                        process:
                    </p>
                    <a href="garden/work-as-a-senior-software-engineer"
                        >Read my full professional narrative</a
                    >
                </div>
            </header>

            <aside class="tech-stack">
                <h3 class="title-font">Core Tools</h3>
                <ul>
                    <li>Javascript / Typescript</li>
                    <li>React / Next.js</li>
                    <li>Astro / Svelte</li>
                    <li>HTML / CSS</li>
                    <li>Rust</li>
                    <li>Linux (Arch)</li>
                </ul>
            </aside>
        </article>

        <section class="projects-section">
            <h2 class="title-font">Work Case Studies</h2>
            <ProjectTease />
        </section>
    </main>
</Layout>

<style>
    h2 {
        font-size: 3rem;
    }
    .work {
        display: grid;
        gap: 3rem;
        margin: 4rem 0;
    }

    .work-header {
        max-width: 60ch;
    }

    .work h2 {
        margin-bottom: 1.5rem;
    }

    .intro {
        margin-bottom: 1rem;
    }

    actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .github-button {
        color: var(--color-text);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
    }

    /* The 360 Degree Animation */
    .github-button:hover {
        transform: rotate(360deg);
        color: var(--accent); /* Optional: changes color on spin */
    }

    /* Ensures the SVG scales nicely */
    .github-button svg {
        width: 40px;
        height: 40px;
    }

    @media (max-width: 768px) {
        .github-button svg {
            width: 32px;
            height: 32px;
        }
    }

    /* Buttons */
    .button {
        padding: 0.6rem 1rem;
        text-decoration: none;
        border: 1px solid currentColor;
    }

    .button.primary {
        background: var(--color-text);
        color: var(--bg);
    }

    .button.icon {
        color: var(--color-text);
    }

    .button:hover {
        opacity: 0.85;
    }

    /* Image */
    .work-image img {
        width: 100%;
        max-height: 420px;
        opacity: 0.9;
    }
    .heading-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .actions {
        display: flex;
        gap: 0.75rem;
    }

    /* Resume button */
    .button.primary {
        font-size: 1.8rem;
        padding: 0.65rem 1.1rem;
    }

    /* GitHub icon button */
    .button.icon {
        padding: 1rem;

        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .button.icon:hover {
        opacity: 0.85;
    }
    /* Desktop */
    @media (min-width: 768px) {
        .work {
            grid-template-columns: 3fr 2fr;
            align-items: start;
        }
    }
    .work-intro {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 4rem;
        margin: 4rem 0;
    }
    .big-intro {
        font-size: 1.5rem;
        line-height: 1.4;
        margin-bottom: 2rem;
    }
    .experience-cta {
        padding: 1.5rem;
        background: var(--accent-light); /* Give it a subtle background */
        border-left: 4px solid var(--accent);
    }
    .tech-stack ul {
        list-style: none;
        padding: 0;
        font-size: 1.2rem;
    }
    @media (max-width: 768px) {
        .work-intro {
            grid-template-columns: 1fr;
        }
    }
</style>
