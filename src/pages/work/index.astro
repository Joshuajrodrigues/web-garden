---
import "@fontsource-variable/cormorant-garamond";
import "@fontsource/ibm-plex-serif";
import "@fontsource/jacquard-24-charted";
import "@fontsource/pirata-one";
import "@fontsource/unifrakturcook";

import { Image } from "astro:assets";
import Layout from "../../layouts/GardenPost.astro";
import contact from "../../images/contact.jpg";

import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";

import ProjectTease from "../../components/ProjectTease.astro";

const startDate = new Date(2021, 7); // August 2021 (0-indexed)
const now = new Date();

let years =
    now.getFullYear() -
    startDate.getFullYear() -
    (now.getMonth() < startDate.getMonth() ? 1 : 0);
---

<Layout
    title="My work and experience over the years"
    description="Work experience summary for hiring managers (hr's) and recuirmtment agents"
    hero="https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/John_Martin_-_The_Great_Day_of_His_Wrath_-_Google_Art_Project.jpg/2560px-John_Martin_-_The_Great_Day_of_His_Wrath_-_Google_Art_Project.jpg"
>
    <main>
        <article class="work-intro">
            <header class="work-header">
                <div class="heading-row">
                    <div class="actions">
                        <a
                            class="button primary"
                            href="/resume/Joshua-Rodrigues-Resume-2024.pdf"
                            target="_blank">Résumé</a
                        >
                    </div>
                </div>

                <p class="big-intro">
                    I’m a <strong>Senior Frontend Engineer</strong> based in Goa,
                    with {years}+ years of experience building specialized
                    systems for scientists, researchers, and government
                    officials.
                </p>

                <div class="experience-cta">
                    <p>
                        For a detailed breakdown of my career path and the tech
                        stacks I've mastered:
                    </p>
                    <a href="garden/work-experience"
                        >Read my full professional narrative →</a
                    >
                </div>
            </header>

            <aside class="tech-stack">
                <h3 class="title-font">Core Tools</h3>
                <ul>
                    <li>Javascript / Typescript</li>
                    <li>React / Next.js</li>
                    <li>Astro / Svelte</li>
                    <li>HTML / CSS</li>
                    <li>Linux (Arch)</li>
                </ul>
            </aside>
        </article>

        <section class="projects-section">
            <h2 class="title-font">Selected Projects</h2>
            <ProjectTease />
        </section>
    </main>
</Layout>

<style>
    main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        background-color: var(--bg);
    }
    h2 {
        font-size: 3rem;
    }
    .work {
        display: grid;
        gap: 3rem;
        margin: 4rem 0;
    }

    .work-header {
        max-width: 60ch;
    }

    .work h2 {
        margin-bottom: 1.5rem;
    }

    .intro {
        margin-bottom: 1rem;
    }

    .actions {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    /* Buttons */
    .button {
        padding: 0.6rem 1rem;
        text-decoration: none;
        border: 1px solid currentColor;
    }

    .button.primary {
        background: var(--color-text);
        color: var(--bg);
    }

    .button.icon {
        color: var(--color-text);
    }

    .button:hover {
        opacity: 0.85;
    }

    /* Image */
    .work-image img {
        width: 100%;
        max-height: 420px;
        opacity: 0.9;
    }
    .heading-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .actions {
        display: flex;
        gap: 0.75rem;
    }

    /* Resume button */
    .button.primary {
        font-size: 1.8rem;
        padding: 0.65rem 1.1rem;
    }

    /* GitHub icon button */
    .button.icon {
        padding: 1rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .button.icon:hover {
        opacity: 0.85;
    }
    /* Desktop */
    @media (min-width: 768px) {
        .work {
            grid-template-columns: 3fr 2fr;
            align-items: start;
        }
    }
    .work-intro {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 4rem;
        margin: 4rem 0;
    }
    .big-intro {
        font-size: 1.5rem;
        line-height: 1.4;
        margin-bottom: 2rem;
    }
    .experience-cta {
        padding: 1.5rem;
        background: var(--accent-light); /* Give it a subtle background */
        border-left: 4px solid var(--accent);
    }
    .tech-stack ul {
        list-style: none;
        padding: 0;
        font-size: 1.2rem;
    }
    @media (max-width: 768px) {
        .work-intro {
            grid-template-columns: 1fr;
        }
    }
</style>
