---
import { type CollectionEntry, getCollection, render } from "astro:content";
import GardenPost from "../../layouts/GardenPost.astro";

export async function getStaticPaths() {
    const posts = await getCollection("garden");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}

type Props = CollectionEntry<"garden">;

const post = Astro.props;
const { Content } = await render(post);

// --- BACKLINKS ---
const allNotes = await getCollection("garden");
const currentId = post.id; //  "arch-linux"
const currentTitle = post.data.title; // "My Arch Linux setup"

const idPattern = currentId.replace(/-/g, "[ -]");
const titlePattern = currentTitle.replace(/-/g, "[ -]");

const linkPattern = new RegExp(
    `\\[\\[(${idPattern}|${titlePattern})(\\|.*?)?\\]\\]`,
    "i",
);

const backlinks = allNotes.filter((note) => {
    if (note.id === post.id) return false;
    return linkPattern.test(note.body || "");
});

const outlinkMatches = post.body?.matchAll(/\[\[(.*?)(?:\|.*?)?\]\]/g) || [];
const outlinkIds = [
    ...new Set(
        Array.from(outlinkMatches).map((match) =>
            match[1].trim().replace(/ /g, "-").toLowerCase(),
        ),
    ),
];
const outlinks = allNotes.filter((note) => outlinkIds.includes(note.id));
---

<GardenPost {...post.data}> 
    <article class="garden-content">
        <Content />
    </article>

    <footer class="library-connections">
        {
            outlinks.length > 0 && (
                <section class="links-section">
                    <hr />
                    <h4 class="fancy-font">References in this note</h4>
                    <ol class="roman-list">
                        {outlinks.map((link) => (
                            <li>
                                <a href={`/garden/${link.id}`}>
                                    {link.data.title}
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )
        }

        {
            backlinks.length > 0 && (
                <section class="links-section">
                    <hr />
                    <h4 class="fancy-font">Linked Mentions (Backlinks)</h4>
                    <ol class="roman-list">
                        {backlinks.map((link) => (
                            <li>
                                <a href={`/garden/${link.id}`}>
                                    {link.data.title}
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )
        }
    </footer>
</GardenPost>

<style>
    .library-connections {
        margin-top: 5rem;
    }
    .links-section {
        margin-bottom: 3rem;
    }
    .roman-list {
        list-style-type: lower-roman;
        padding-left: 1.5rem;
    }
    .garden-content {
        line-height: 1.6;
        margin-bottom: 3rem;
    }

    /* Backlinks Section */
    .backlinks-container {
        margin-top: 4rem;
    }

    .backlinks-title {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .backlinks-list {
        list-style-type: upper-roman;
        padding-left: 1.5rem;
    }

    .backlinks-list li {
        margin-bottom: 0.5rem;
    }

    .backlinks-list a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: opacity 0.2s ease;
    }

    .backlinks-list a:hover {
        opacity: 0.7;
    }

    hr {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 2rem 0;
    }
</style>
